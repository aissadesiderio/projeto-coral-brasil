# Copie para backend/.env e ajuste. NUNCA versione o .env com valores reais.
# O settings.py le este arquivo via django-environ; variaveis reais de
# processo tem precedencia sobre o que estiver aqui.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_DEBUG=True

# Obrigatoria quando DJANGO_DEBUG=False - o servico se recusa a subir sem ela.
# Com DJANGO_DEBUG=True, deixar comentada faz o projeto usar uma chave de
# desenvolvimento. NAO deixe "DJANGO_SECRET_KEY=" vazio: variavel definida como
# string vazia sobrescreve o default.
#
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=cole-a-chave-aqui

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mantem o site publico indisponivel durante a reestruturacao
OFFLINE_MODE=True

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Sem DATABASE_URL, o projeto usa SQLite em backend/db.sqlite3.
# Para PostgreSQL, descomente psycopg no requirements.txt e defina:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/coral_brasil

# ---------------------------------------------------------------------------
# Neo4j (grafo cientifico)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Fontes externas de dados (Fase B - ingestao automatizada)
# ---------------------------------------------------------------------------
# Copernicus Marine Service - conta gratuita:
#     https://data.marine.copernicus.eu/register
#
# NAO e o cadastro de www.copernicus.eu (portal do programa, hoje arquivado)
# nem do Climate Data Store. Sao tres servicos diferentes com contas
# diferentes. Use o USERNAME do cadastro, nao o e-mail.
#
# PREFIRA NAO USAR ESTAS DUAS LINHAS. Rode:
#     copernicusmarine login
# e digite usuario e senha quando ele pedir. As credenciais ficam em
# ~/.copernicusmarine, fora do projeto - sem risco de ir num commit, aparecer
# num print da pasta ou no historico do shell. O `testar_fontes` reconhece as
# duas formas.
#
# Deixe vazio se usar o login acima.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# NOAA Coral Reef Watch via ERDDAP - acesso publico, sem credencial.
# Servidor e dataset andam EM PAR: cada espelho publica o produto sob um id
# proprio. Trocar so um dos dois gera 404.
#
# Rode "python backend/manage.py testar_fontes" para descobrir o par que
# funciona na sua rede. Situacao verificada em 25/07/2026:
#   pfeg (padrao) : coastwatch.pfeg.noaa.gov/erddap    + NOAA_DHW         OK 5/5
#   NOAA          : coastwatch.noaa.gov/erddap         + noaacrwdhwDaily  403
#   PACIOOS       : pae-paha.pacioos.hawaii.edu/erddap + dhw_5km          cert invalido
NOAA_ERDDAP_SERVER=https://coastwatch.pfeg.noaa.gov/erddap
NOAA_ERDDAP_DATASET=NOAA_DHW

# Tentativas por fonte antes de desistir. So vale para falhas passageiras
# (503, timeout) - certificado invalido e 403 falham na primeira. Espera
# 10s antes da 2a tentativa e 30s antes da 3a.
INGESTAO_TENTATIVAS=3

# O periodo pedido e fatiado em blocos deste tamanho antes de virar requisicao.
# Pedir varios anos de uma vez faz o ERDDAP responder 408/ReadTimeout. Diminua
# se ainda houver timeout; aumente so se a rede for muito boa.
INGESTAO_JANELA_DIAS=180
