# Variaveis do docker-compose.yml - infraestrutura local (PostgreSQL + Neo4j).
#
# ATENCAO: este arquivo NAO e o do Django. Sao dois, com papeis diferentes:
#
#   .env          (este)  -> lido pelo `docker compose`, CRIA os bancos
#   backend/.env          -> lido pelo Django, CONECTA neles
#
# As senhas precisam bater entre os dois. E a unica duplicacao do projeto, e
# existe porque quem cria o banco e quem se conecta a ele sao processos
# diferentes, em momentos diferentes.
#
# (Ate 25/07/2026 este arquivo era uma copia desatualizada do
# backend/.env.example e nao era lido por nada - o Django le apenas
# backend/.env. Passou a ser o do Docker.)
#
# Copie para `.env` (sem o .example) so se quiser mudar algum valor. O compose
# tem estes mesmos padroes embutidos e sobe sem este arquivo existir.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=coral_brasil
POSTGRES_USER=coral
POSTGRES_PASSWORD=coral_dev_local
POSTGRES_PORT=5432

# --- Neo4j ------------------------------------------------------------------
# Minimo de 8 caracteres: o Neo4j 5 se recusa a subir com menos, e a mensagem
# aparece so em `docker compose logs neo4j`.
NEO4J_USER=neo4j
NEO4J_PASSWORD=coral_dev_local
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ⚠️ Estas credenciais sao de desenvolvimento local e estao no repositorio como
# exemplo. As portas ficam expostas em localhost. Nunca use estes valores em
# maquina com IP publico nem em deploy - la as senhas vem do gerenciador de
# segredos do provedor, nunca de arquivo versionado.
#
# Use senhas so com letras, numeros e sublinhado: a do Postgres vai dentro da
# DATABASE_URL em backend/.env, e @ : / # tem significado dentro de uma URL.
